{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig*.json", ".eslintrc.cjs"],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "components/**", "lib/**", "public/**", "*.config.*", "tsconfig*.json"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**", "app/**", "components/**", "lib/**", ".eslintrc.cjs"],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["src/**", "app/**", "components/**", "lib/**", "tsconfig*.json"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**", "app/**", "components/**", "lib/**", "vitest.*"],
      "outputs": []
    }
  }
}
