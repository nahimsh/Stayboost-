// StayBoost data model. Multi-tenant tables carry org_id + Postgres RLS;
// platform-level tables (e.g. pre-signup leads) do not. Models are added per
// feature — this currently covers Phase 1's Contact feature. Money is stored as
// integer minor units; timestamps are UTC.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

/// Tenant root. Every tenant-owned row is scoped by org_id and protected by RLS.
model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  type            String   @default("hotel")
  country         String?
  defaultCurrency String   @default("USD") @map("default_currency")
  defaultLocale   String   @default("en") @map("default_locale")
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  properties  Property[]

  @@map("organizations")
}

/// A person. Global identity; belongs to orgs via Membership. May authenticate
/// with a password, OAuth, or magic link.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  status          String    @default("active")
  locale          String    @default("en")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   Membership[]
  sessions      Session[]
  tokens        VerificationToken[]
  oauthAccounts OAuthAccount[]

  @@map("users")
}

/// User ↔ Organization with a role. Tenant-owned (org_id) + RLS.
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("staff")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

/// A property the org operates. Tenant-owned (org_id) + RLS. Created by the
/// Property Setup Wizard at onboarding; powers the Analyzer and Dashboard.
model Property {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  name         String
  type         String
  country      String
  city         String
  airbnbUrl    String?  @map("airbnb_url")
  bookingUrl   String?  @map("booking_url")
  websiteUrl   String?  @map("website_url")
  roomsCount   Int      @map("rooms_count")
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("properties")
}

/// A refresh-token session. The opaque refresh token is stored hashed; rotation
/// replaces a row and links via replaced_by_id so reuse can be detected.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Single-use, hashed-at-rest tokens for email verification, password reset, and
/// magic-link login.
model VerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

/// A linked external identity provider account (e.g. Google).
model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Immutable audit trail of human/system write actions (security + compliance).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  ip          String?
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Anonymous AI Property Analyzer result, addressable by a claim token. Created
/// pre-signup (org_id null); attached to an org when the visitor signs up.
model AnalyzerReport {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  orgId     String?  @map("org_id") @db.Uuid
  input     Json
  report    Json
  engine    String
  model     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([orgId])
  @@map("analyzer_reports")
}

/// Audit log of every AI action (golden rule #2). org_id is null for pre-signup
/// actions like the public Analyzer; populated once a tenant context exists.
model AiAction {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String?  @map("org_id") @db.Uuid
  agent      String
  actionType String   @map("action_type")
  input      Json
  output     Json
  rationale  String?
  model      String
  engine     String?
  status     String
  costMinor  BigInt?  @map("cost_minor")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, createdAt])
  @@index([agent, createdAt])
  @@map("ai_actions")
}

/// Inbound contact / sales lead captured before signup. Platform-level (not
/// tenant-owned): only internal/admin contexts read it.
model ContactLead {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String
  company       String?
  propertyCount Int?     @map("property_count")
  reason        String
  message       String
  source        String   @default("web")
  status        String   @default("new")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([reason, status])
  @@map("contact_leads")
}
