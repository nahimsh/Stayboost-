# Copy to .env and fill in. NEVER commit real secrets.

# --- Database ---
DATABASE_URL="postgresql://stayboost:stayboost@localhost:5432/stayboost?schema=public"

# --- Redis (rate limiting, cache, queues) ---
REDIS_URL="redis://localhost:6379"

# --- Core API ---
API_PORT=4000
# Comma-separated list of allowed browser origins (CORS).
WEB_ORIGIN="http://localhost:3000"

# --- Web ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Email (Resend) ---
# When unset, the mailer logs instead of sending (safe for local/dev).
RESEND_API_KEY=""
CONTACT_INBOX="team@stayboost.com"
EMAIL_FROM="StayBoost <hello@stayboost.com>"

# --- AI service (FastAPI, services/ai) ---
# Core API → AI service URL + shared service token (set both in production).
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TOKEN=""

# --- AI service env (services/ai) ---
# When ANTHROPIC_API_KEY is unset, the analyzer uses the deterministic heuristic
# engine — a real offline baseline, so it works without a key in dev/CI.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
AI_EFFORT="high"
AI_ALLOWED_ORIGINS="http://localhost:4000"
