# Copy to .env and fill in. NEVER commit real secrets.

# --- Database ---
DATABASE_URL="postgresql://stayboost:stayboost@localhost:5432/stayboost?schema=public"

# --- Redis (rate limiting, cache, queues) ---
REDIS_URL="redis://localhost:6379"

# --- Core API ---
API_PORT=4000
# Comma-separated list of allowed browser origins (CORS).
WEB_ORIGIN="http://localhost:3000"

# --- Web ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Email (Resend) ---
# When unset, the mailer logs instead of sending (safe for local/dev).
RESEND_API_KEY=""
CONTACT_INBOX="team@stayboost.com"
EMAIL_FROM="StayBoost <hello@stayboost.com>"
