# Copy to .env and fill in. NEVER commit real secrets.

# --- Database ---
DATABASE_URL="postgresql://stayboost:stayboost@localhost:5432/stayboost?schema=public"

# --- Redis (rate limiting, cache, queues) ---
REDIS_URL="redis://localhost:6379"

# --- Core API ---
API_PORT=4000
# Comma-separated list of allowed browser origins (CORS).
WEB_ORIGIN="http://localhost:3000"

# --- Web ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Email (Resend) ---
# When unset, the mailer logs instead of sending (safe for local/dev).
RESEND_API_KEY=""
CONTACT_INBOX="team@stayboost.com"
EMAIL_FROM="StayBoost <hello@stayboost.com>"

# --- Auth ---
# Generate a strong secret (e.g. `openssl rand -base64 48`). Required in production.
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30
# Must be "true" in production (cookies require HTTPS).
AUTH_COOKIE_SECURE="false"
COOKIE_DOMAIN=""
APP_URL="http://localhost:3000"
# Google OAuth (optional; sign-in button hides/falls back when unset).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/v1/auth/google/callback"

# --- AI service (FastAPI, services/ai) ---
# Core API → AI service URL + shared service token (set both in production).
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TOKEN=""

# --- AI service env (services/ai) ---
# When ANTHROPIC_API_KEY is unset, the analyzer uses the deterministic heuristic
# engine — a real offline baseline, so it works without a key in dev/CI.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
AI_EFFORT="high"
AI_ALLOWED_ORIGINS="http://localhost:4000"

# --- Observability (Sentry) ---
# Create projects at sentry.io and paste the DSNs here.
# Leave empty in dev/CI — Sentry is disabled when unset.
# SENTRY_DSN is required in production (validated by env.ts superRefine).
# NEXT_PUBLIC_SENTRY_DSN is the same DSN value; the NEXT_PUBLIC_ prefix makes it
# available to the browser bundle compiled by Next.js.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
AI_SENTRY_DSN=""
# Needed only for source-map uploads to Sentry during CI/CD builds (optional).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
