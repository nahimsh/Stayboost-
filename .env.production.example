# StayBoost production environment (per service). Copy values into Railway/Vercel
# service variables. NEVER commit real secrets — this file holds placeholders only.

# ───────────────────────── Core API (Railway) ─────────────────────────
NODE_ENV=production
API_PORT=4000
# Use a NON-OWNER role so Postgres RLS FORCE fully applies (see docs/deployment.md).
DATABASE_URL=postgresql://app:CHANGE_ME@HOST:5432/stayboost?schema=public&sslmode=require
REDIS_URL=redis://default:CHANGE_ME@HOST:6379
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
# Shared parent domain so auth cookies work across web <-> api subdomains.
COOKIE_DOMAIN=.stayboost.com
APP_URL=https://app.stayboost.com
WEB_ORIGIN=https://app.stayboost.com
AI_SERVICE_URL=https://stayboost-ai.up.railway.app
AI_SERVICE_TOKEN=CHANGE_ME_SHARED_WITH_AI_SERVICE
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=StayBoost <hello@stayboost.com>
CONTACT_INBOX=team@stayboost.com
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://api.stayboost.com/v1/auth/google/callback
MAX_BODY_SIZE=16kb

# ───────────────────────── AI service (Railway) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-opus-4-8
AI_EFFORT=high
AI_SERVICE_TOKEN=CHANGE_ME_SHARED_WITH_API
AI_ALLOWED_ORIGINS=https://api.stayboost.com

# ───────────────────────── Web (Vercel) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=https://app.stayboost.com
NEXT_PUBLIC_API_URL=https://api.stayboost.com
